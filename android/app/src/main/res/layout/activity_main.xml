<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/problem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/error_tint"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/problem_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="12dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/problem_action"
            style="@style/TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/list_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="4dp">

            <!-- Bounds the title, which stays only as wide as its text. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

            <TextView
                android:id="@+id/list_title"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:background="@drawable/row"
                android:contentDescription="@string/choose_notebook"
                android:drawableEnd="@drawable/ic_drop_down"
                android:drawablePadding="2dp"
                android:drawableTint="@color/ink_muted"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
            </FrameLayout>

                <ImageButton
                    android:id="@+id/sync_button"
                    style="@style/ToolbarButton"
                    android:contentDescription="@string/sync_off"
                    android:src="@drawable/ic_sync" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/search"
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/ink_muted"
                    android:hint="@string/search_notes"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="48dp" />

                <ImageButton
                    android:id="@+id/search_clear"
                    style="@style/ToolbarButton"
                    android:layout_gravity="end|center_vertical"
                    android:contentDescription="@string/clear_search"
                    android:src="@drawable/ic_close"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/notes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="2dp"
                    android:listSelector="@android:color/transparent"
                    android:paddingHorizontal="8dp"
                    android:paddingBottom="96dp"
                    android:scrollbarStyle="outsideOverlay" />

                <TextView
                    android:id="@+id/list_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="48dp"
                    android:drawableTop="@drawable/ic_empty"
                    android:drawablePadding="16dp"
                    android:gravity="center"
                    android:text="@string/no_notes"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/new_note"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="20dp"
                    android:background="@drawable/fab"
                    android:drawableStart="@drawable/ic_add"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/on_accent"
                    android:elevation="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:outlineAmbientShadowColor="@color/accent"
                    android:outlineSpotShadowColor="@color/accent"
                    android:paddingStart="16dp"
                    android:paddingEnd="20dp"
                    android:stateListAnimator="@null"
                    android:text="@string/new_note"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="15sp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/editor_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/back"
                    style="@style/ToolbarButton"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_back"
                    android:tint="@color/text_primary" />

                <!-- Bounds the notebook chip, which stays only as wide as its text. -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/location"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/chip"
                        android:contentDescription="@string/move_note"
                        android:drawableEnd="@drawable/ic_drop_down"
                        android:drawableTint="@color/toolbar_icon"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="6dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/open_link"
                    style="@style/ToolbarButton"
                    android:contentDescription="@string/open_link"
                    android:src="@drawable/ic_open_link"
                    android:tint="@color/accent_ink"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/undo"
                    style="@style/ToolbarButton"
                    android:contentDescription="@string/undo"
                    android:src="@drawable/ic_undo" />

                <ImageButton
                    android:id="@+id/redo"
                    style="@style/ToolbarButton"
                    android:contentDescription="@string/redo"
                    android:src="@drawable/ic_redo" />

                <ImageButton
                    android:id="@+id/restore"
                    style="@style/ToolbarButton"
                    android:contentDescription="@string/restore"
                    android:src="@drawable/ic_restore"
                    android:tooltipText="@string/restore"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/more"
                    style="@style/ToolbarButton"
                    android:contentDescription="@string/more"
                    android:src="@drawable/ic_more" />
            </LinearLayout>

            <com.pkkulhari.notebook.NoteEditText
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/start_writing"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
                android:lineSpacingMultiplier="1.3"
                android:paddingHorizontal="22dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/ink_faint"
                android:textSize="17sp" />
        </LinearLayout>

        <include layout="@layout/sync_screen" />
    </FrameLayout>
</LinearLayout>
