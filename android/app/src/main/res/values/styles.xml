<resources>
    <style name="ToolbarButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/toolbar_icon</item>
    </style>

    <style name="Field">
        <item name="android:background">@drawable/field</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/ink_faint</item>
    </style>

    <!-- From the platform button, so buttons made in code keep its behaviour. -->
    <style name="BaseButton" parent="android:Widget.DeviceDefault.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="FilledButton" parent="BaseButton">
        <item name="android:background">@drawable/button_filled</item>
        <item name="android:textColor">@color/on_accent_text</item>
    </style>

    <style name="TonalButton" parent="BaseButton">
        <item name="android:background">@drawable/button_tonal</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>

    <style name="TextButton" parent="BaseButton">
        <item name="android:background">@drawable/button_text</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>

    <style name="SyncEyebrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/accent_ink</item>
    </style>

    <style name="SyncHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginVertical">4dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
